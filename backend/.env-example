# Valores exclusivos para desenvolvimento local com Docker Compose.
DATABASE_URL=postgresql://inventory:inventory_local@localhost:5432/inventory_audit
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Obrigatório: substitua por um valor aleatório antes de iniciar a API.
JWT_SECRET=replace-with-a-random-development-secret
JWT_EXPIRES_IN=1d
